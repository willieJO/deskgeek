# Same configuration keys and Brevo provider as GymFlow.
# Export these variables in your shell/service. .NET does not automatically read .env files.
Brevo__ApiKey=
Brevo__SenderEmail=
Brevo__SenderName=MediaDex
RabbitMq__ConnectionString=amqp://guest:guest@localhost:5672/
ReleaseReminders__Enabled=true
ReleaseReminders__SendHour=12
ReleaseReminders__FrontendUrl=https://mediadex.devporwillie.shop
# Use the same SQL Server/database as the API. Set this when not using appsettings/user-secrets.
# ConnectionStrings__DefaultConnection=
